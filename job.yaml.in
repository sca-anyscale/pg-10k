requirements:
  # - daft==0.6.2
  # - torch==2.7.0
  # - torchvision==0.22.0
  # - numpy==1.26.4

 
# Path to a local directory or a remote URI to a .zip file (S3, GS, HTTP) that
# will be the working directory for the job. The files in the directory will be
# automatically uploaded to the job environment in Anyscale.
working_dir: .

# When empty, this uses the default Anyscale Cloud in your organization.
cloud: anyscale_v2_default_cloud

env_vars:
  RAY_centralized_actor_scheduling: "true"
  # RAY_BACKEND_LOG_LEVEL: "debug"
  ANYSCALE_DISABLE_OPTIMIZED_RAY: "true"
  ANYSCALE_DISABLE_GITIGNORE_EXCLUSION: "1"
  PROFILER_MODE: "none"          # "nsys", "torch", or "none"
  PYSPY_ENABLED: "0"             # Enable py-spy CPU profiling
  PERF_PROFILING_ENABLED: "1"    # Enable perf record on raylet/gcs
  PERF_NUM_CPU_WORKERS: "5"
  PERF_NUM_GPU_WORKERS: "0"
  PROFILING_STORAGE_DIR: "/mnt/shared_storage"
  PROFILING_STORAGE_TYPE: "s3"   # S3 or GCs at present

# The script to run in your job. You can also do "uv run main.py" if you have a
# pyproject.toml file in your working_dir.
#entrypoint: python ray_data_main.py
# entrypoint: python ray_data_main_network_monitor.py
entrypoint: bash -x ./RUNIT

# If there is an error, do not retry.
max_retries: 0

# Kill the job after 2 hours to control costs.
timeout_s: 28800
#flags:
#  disable_nfs_mount: true
#  allow-cross-zone-autoscaling: true
#  enable_multi_az_serve: true
